        <Param val="1.4" valType="num" updates="constant" name="wrapWidth"/>
      </TextComponent>
      <CodeComponent name="init_code" plugin="None">
        <Param val="def median_value(values):&amp;#10;    ordered = sorted(values)&amp;#10;    n = len(ordered)&amp;#10;    if n == 0:&amp;#10;        return 8.0&amp;#10;    middle = n // 2&amp;#10;    if n % 2 == 1:&amp;#10;        return float(ordered[middle])&amp;#10;    return float((ordered[middle - 1] + ordered[middle]) / 2.0)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="var probeCondition = &quot;&quot;;&amp;#10;var probeSchedule = [];&amp;#10;var globalTrialN = 0;&amp;#10;var questLevels = [];&amp;#10;var tiltDeg = 8.0;&amp;#10;var probeThisTrial = 0;&amp;#10;var trialIndex = -1;&amp;#10;var choiceMade = 0;&amp;#10;var confidenceMade = 0;&amp;#10;var showConfInstr = 0;&amp;#10;var showNeutralInstr = 1;&amp;#10;var feedbackText = &quot;&quot;;&amp;#10;var feedbackColor = &quot;#ffdc00&quot;;&amp;#10;var blockText = &quot;&quot;;&amp;#10;var breakText = &quot;&quot;;&amp;#10;var FINISHED = PsychoJS.Status.FINISHED;  // used in the conditional start of *_wait_fix&amp;#10;var calibTiltSign = 1;&amp;#10;var calibCorrAns = &quot;j&quot;;&amp;#10;&amp;#10;function shuffledCopy(values) {&amp;#10;    let output = values.slice();&amp;#10;    for (let i = output.length - 1; i &gt; 0; i--) {&amp;#10;        const j = Math.floor(Math.random() * (i + 1));&amp;#10;        const temporary = output[i];&amp;#10;        output[i] = output[j];&amp;#10;        output[j] = temporary;&amp;#10;    }&amp;#10;    return output;&amp;#10;}&amp;#10;&amp;#10;function medianValue(values) {&amp;#10;    let ordered = values.slice().sort((a, b) =&gt; a - b);&amp;#10;    let n = ordered.length;&amp;#10;    if (n === 0) {&amp;#10;        return 8.0;&amp;#10;    }&amp;#10;    let middle = Math.floor(n / 2);&amp;#10;    if (n % 2 === 1) {&amp;#10;        return Number(ordered[middle]);&amp;#10;    }&amp;#10;    return Number((ordered[middle - 1] + ordered[middle]) / 2.0);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="probeCondition = str(expInfo['condition']).strip().lower()&amp;#10;validConditions = ['no_probe', 'sparse_probe', 'full_probe']&amp;#10;if probeCondition not in validConditions:&amp;#10;    raise ValueError('condition must be no_probe, sparse_probe, or full_probe')&amp;#10;&amp;#10;probeSchedule = []&amp;#10;for blockN in range(4):&amp;#10;    oneBlock = [1] * 10 + [0] * 30&amp;#10;    shuffle(oneBlock)&amp;#10;    probeSchedule.extend(oneBlock)&amp;#10;&amp;#10;showConfInstr = int(probeCondition != 'no_probe')&amp;#10;showNeutralInstr = 1 - showConfInstr&amp;#10;globalTrialN = 0&amp;#10;questLevels = []&amp;#10;tiltDeg = 8.0&amp;#10;probeThisTrial = 0&amp;#10;trialIndex = -1&amp;#10;choiceMade = 0&amp;#10;confidenceMade = 0&amp;#10;thisExp.addData('probeScheduleString', ''.join(str(p) for p in probeSchedule))&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="probeCondition = String(expInfo['condition']).trim().toLowerCase();&amp;#10;let validConditions = ['no_probe', 'sparse_probe', 'full_probe'];&amp;#10;if (!validConditions.includes(probeCondition)) {&amp;#10;    throw new Error('condition must be no_probe, sparse_probe, or full_probe');&amp;#10;}&amp;#10;&amp;#10;probeSchedule = [];&amp;#10;for (let blockN = 0; blockN &lt; 4; blockN++) {&amp;#10;    let oneBlock = Array(10).fill(1).concat(Array(30).fill(0));&amp;#10;    oneBlock = shuffledCopy(oneBlock);&amp;#10;    probeSchedule = probeSchedule.concat(oneBlock);&amp;#10;}&amp;#10;&amp;#10;showConfInstr = (probeCondition !== 'no_probe') ? 1 : 0;&amp;#10;showNeutralInstr = 1 - showConfInstr;&amp;#10;psychoJS.experiment.addData('probeScheduleString', probeSchedule.join(''));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
