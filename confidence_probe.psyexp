        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if (practice_resp.keys === undefined || practice_resp.keys === null || practice_resp.keys.length === 0) {&amp;#10;    feedbackText = 'Too slow';&amp;#10;    feedbackColor = '#ffdc00';&amp;#10;} else if (practice_resp.corr === 1) {&amp;#10;    feedbackText = 'Correct';&amp;#10;    feedbackColor = '#2ecc40';&amp;#10;} else {&amp;#10;    feedbackText = 'Incorrect';&amp;#10;    feedbackColor = '#ff4136';&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
