    <Routine name="main_fixation"/>
    <Routine name="main_decision"/>
    <Routine name="main_post"/>
    <Routine name="main_iti"/>
    <LoopTerminator name="mainTrials"/>
    <Routine name="block_break"/>
    <LoopTerminator name="mainBlocks"/>
    <Routine name="thanks"/>
  </Flow>
</PsychoPy2experiment>
