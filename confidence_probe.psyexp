        <Param val="if random() &lt; 0.5:&amp;#10;    calibTiltSign = -1&amp;#10;    calibCorrAns = 'f'&amp;#10;else:&amp;#10;    calibTiltSign = 1&amp;#10;    calibCorrAns = 'j'&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
