        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="if decisionEnd &lt; 0:&amp;#10;    if main_resp.keys and t &gt;= 1.0 + 0.15:&amp;#10;        decisionEnd = t&amp;#10;    elif t &gt;= 1.0 + 1.5:&amp;#10;        decisionEnd = t&amp;#10;if decisionEnd &gt;= 0:&amp;#10;    if (probeThisTrial == 1 and bool(main_resp.keys)):&amp;#10;        continueRoutine = False&amp;#10;    elif t &gt;= decisionEnd + 1.5:&amp;#10;        continueRoutine = False&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (decisionEnd &lt; 0) {&amp;#10;    if (main_resp.keys !== undefined &amp;&amp; main_resp.keys !== null &amp;&amp; main_resp.keys.length &gt; 0 &amp;&amp; t &gt;= 1.0 + 0.15) {&amp;#10;        decisionEnd = t;&amp;#10;    } else if (t &gt;= 1.0 + 1.5) {&amp;#10;        decisionEnd = t;&amp;#10;    }&amp;#10;}&amp;#10;if (decisionEnd &gt;= 0) {&amp;#10;    if ((probeThisTrial === 1 &amp;&amp; main_resp.keys !== undefined &amp;&amp; main_resp.keys !== null &amp;&amp; main_resp.keys.length &gt; 0)) {&amp;#10;        continueRoutine = false;&amp;#10;    } else if (t &gt;= decisionEnd + 1.5) {&amp;#10;        continueRoutine = false;&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
