    <Routine name="practice_fixation"/>
    <Routine name="practice_decision"/>
    <Routine name="practice_feedback"/>
    <Routine name="practice_iti"/>
    <LoopTerminator name="practiceTrials"/>
    <Routine name="calibration_intro"/>
    <LoopInitiator loopType="MultiStairHandler" name="calibrationTrials">
      <Param name="conditions" updates="None" val="[]" valType="list"/>
      <Param name="conditionsFile" updates="None" val="conditions/quest_conditions.csv" valType="file"/>
      <Param name="conditionsFile_QUEST" updates="None" val="conditions/quest_conditions.csv" valType="file"/>
      <Param name="conditionsFile_questplus" updates="None" val="conditions/quest_conditions.csv" valType="file"/>
      <Param name="conditionsFile_simple" updates="None" val="conditions/quest_conditions.csv" valType="file"/>
      <Param name="isTrials" updates="None" val="True" valType="bool"/>
      <Param name="nReps" updates="None" val="40" valType="num"/>
      <Param name="name" updates="None" val="calibrationTrials" valType="code"/>
      <Param name="stairType" updates="None" val="QUEST" valType="str"/>
      <Param name="switchMethod" updates="None" val="sequential" valType="str"/>
    </LoopInitiator>
    <Routine name="calibration_fixation"/>
    <Routine name="calibration_decision"/>
    <Routine name="calibration_iti"/>
    <LoopTerminator name="calibrationTrials"/>
    <Routine name="calibration_summary"/>
    <Routine name="baseline_intro"/>
    <LoopInitiator loopType="TrialHandler" name="baselineTrials">
      <Param name="Selected rows" updates="None" val="" valType="str"/>
      <Param name="conditions" updates="None" val="[OrderedDict([('tiltSign', np.int64(-1)), ('corrAns', 'f'), ('orientationLabel', 'left')]), OrderedDict([('tiltSign', np.int64(1)), ('corrAns', 'j'), ('orientationLabel', 'right')])]" valType="str"/>
      <Param name="conditionsFile" updates="None" val="conditions/two_orientations.csv" valType="file"/>
      <Param name="endPoints" updates="None" val="[0, 1]" valType="code"/>
